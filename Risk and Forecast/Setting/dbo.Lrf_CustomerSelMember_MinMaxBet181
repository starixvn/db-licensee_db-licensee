CREATE PROCEDURE dbo.Lrf_CustomerSelMember_MinMaxBet181
	@custid INT
AS
/*
Created: 20130911@Jim
Task : support Virtual Horse Racing
DB: DB052.bodb02
Original: Lrf_CustomerSelMember_MinMaxBet180

Revisions:
   
Param's Explanation:
• @CustID: customer id.   
*/

DECLARE	@UserName VARCHAR(30), @recommend INT

DECLARE @minminbet MONEY,
	@maxmaxbet MONEY,
	@maxmaxpermatch MONEY
	
SELECT @UserName = username, @recommend = recommend
from customer with (NOLOCK)
WHERE roleid = 1 AND CustID = @CustID

IF (@username = NULL) RETURN

SELECT
	@MinMinBet = Max(CASE WHEN MinBet = 0 THEN NULL ELSE MinBet END), 
	@MaxMaxBet = Min(CASE WHEN MaxBet = 0 THEN NULL ELSE MaxBet END)
from 
	Dep_CustSetting3rd as cs WITH (NOLOCK)
	INNER JOIN custinfo as ci WITH (NOLOCK) on (cs.CustID = ci.Recommend or cs.CustID = ci.MRecommend or cs.CustID = ci.SRecommend)
	AND cs.bettype IN  (1231,1232,1233,1237,1238) AND cs.sporttype=181
WHERE ci.custid = @recommend

SELECT @MaxMaxperMatch = Min(CASE WHEN cs.maxpermatch181 = 0 THEN NULL ELSE cs.maxpermatch180 END)
from 
	custinfo as cs WITH (NOLOCK) 
	INNER JOIN custinfo as ci WITH (NOLOCK) on (cs.CustID = ci.Recommend or cs.CustID = ci.MRecommend or cs.CustID = ci.SRecommend)
WHERE ci.custid = @recommend

SELECT isnull(@minminbet,0) minminbet,
		isnull(@maxmaxbet,0) maxmaxbet,
		isnull(@maxmaxpermatch,0) maxmaxpermatch,
		0 AS maxpermatch_min,
		ci.maxpermatch180 maxpermatch,
		cs.minbet,
		cs.maxbet
FROM custinfo ci WITH(NOLOCK)
INNER JOIN Dep_CustSetting3rd cs ON ci.custid = cs.custid
WHERE ci.custid = @custid AND cs.sporttype = 181 AND cs.bettype IN  (1231, 1232, 1233, 1237, 1238)
GO

GRANT EXECUTE ON [dbo].[Lrf_CustomerSelMember_MinMaxBet181] TO [bodbLicenseeNet]
GO
GRANT VIEW DEFINITION ON [dbo].[Lrf_CustomerSelMember_MinMaxBet181] TO vnteam

